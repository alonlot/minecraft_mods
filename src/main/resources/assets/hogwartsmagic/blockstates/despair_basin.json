{
  "multipart": [
    {
      "apply": {
        "model": "hogwartsmagic:block/despair_basin_looted"
      }
    },
    {
      "when": {
        "level": "1",
        "stage": "full|drinking"
      },
      "apply": {
        "model": "hogwartsmagic:block/despair_basin_liquid_1"
      }
    },
    {
      "when": {
        "level": "2",
        "stage": "full|drinking"
      },
      "apply": {
        "model": "hogwartsmagic:block/despair_basin_liquid_2"
      }
    },
    {
      "when": {
        "level": "3",
        "stage": "full|drinking"
      },
      "apply": {
        "model": "hogwartsmagic:block/despair_basin_liquid_3"
      }
    },
    {
      "when": {
        "level": "4",
        "stage": "full|drinking"
      },
      "apply": {
        "model": "hogwartsmagic:block/despair_basin_liquid_4"
      }
    },
    {
      "when": {
        "level": "5",
        "stage": "full|drinking"
      },
      "apply": {
        "model": "hogwartsmagic:block/despair_basin_liquid_5"
      }
    },
    {
      "when": {
        "level": "6",
        "stage": "full|drinking"
      },
      "apply": {
        "model": "hogwartsmagic:block/despair_basin_liquid_6"
      }
    },
    {
      "when": {
        "locket": "true"
      },
      "apply": {
        "model": "hogwartsmagic:block/despair_basin_locket_piece"
      }
    }
  ]
}
